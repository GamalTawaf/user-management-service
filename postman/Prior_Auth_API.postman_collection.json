  "item": [
    {
      "name": "Activate Route",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/users/{{user_id}}/activate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "users",
            ":user_id",
            "activate"
          ],
          "variable": [
            {
              "key": "user_id",
              "value": "{{user_id}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function setEnv(key, value) {",
              "  if (value === undefined || value === null || value === \"\") return;",
              "  const s = String(value);",
              "  pm.environment.set(key, s);",
              "  pm.collectionVariables.set(key, s);",
              "}",
              "function parseBody() {",
              "  try { return pm.response.json(); } catch (e) { return null; }",
              "}",
              "const body = parseBody();",
              "if (body && body.uuid) setEnv('user_id', body.uuid);"
            ]
          }
        }
      ]
    },
